#!/lata/bash
# ════════════════════════════════════════════════════════
# FUSION SSH - Instalador Automático v1.0
# Otimizado para VPS de 512 MB-1 GB de RAM
# ═══════════════════════════════════════════════════════

definir -e

# Núcleos
VERMELHO='\033[0;31m'
VERDE='\033[0;32m'
AZUL='\033[0;34m'
CIANO='\033[0;36m'
AMARELO='\033[1;33m'
NC='\033[0m'

# Verificações
se [[ $EUID -ne 0 ]]; entidade
 echo -e "${RED}❌ Execute como root${NC}"
 saída 1
fi

se [[ ! -f/etc/os-release ]]; entidade
 echo -e "${RED}❌ Sistema não suportado${NC}"
 saída 1
fi

fonte/etc/os-release
se [[ "$ID"!= "ubuntu" e "$ID"!= "debiano" ]]; entidade
 echo -e "${RED}❌ Use Ubuntu/Debian${NC}"
 saída 1
fi

claro
echo -e "${CYAN}"
gato << "EOF"
 ╔═══════════════════════════════════════════╗
 ║ FUSÃO SSH - Implantar Rápido v1.0 ⚡ ║
 ║ SSH + V2Ray + XRay + Stunnel + Painel ║
 ╚═══════════════════════════════════════════╝
EOF
eco -e "${NC}"

# Configurações
SSH_PORTA=22
DROPBEAR_PORT=443
PORTA_ESTRONDOSA=8443
V2RAY_PORT=10000
PORTA_XRAY=10001
ADMIN_USER="fusão"ADMIN_PASS=$(openssl rand -base64 12)

echo -e "${VERDE}📦 Atualizando sistema...${NC}"
atualização do apt && atualização do apt -y -qq

echo -e "${VERDE}📥 Instalando dependências...${NC}"
apt install -y -qq curl wget git unzip zip jq htop net-tools \
 openssh-server dropbear stunnel4 squid iptables-persistente \
 python3 python3-pip fail2ban cron

echo -e "${VERDE}🔧 Configurando SSH + Dropbear...${NC}"
sed -i "s/^#Port 22/Porta $SSH_PORT/" /etc/ssh/sshd_config
systemctl reiniciar ssh

gato > /etc/default/dropbear << EOF
NO_INÍCIO=0
DROPBEAR_PORT=$DROPBEAR_PORT
DROPBEAR_EXTRA_ARGS="-p $DROPBEAR_PORT -s -g"
EOF
systemctl habilitar dropbear && systemctl reiniciar dropbear

echo -e "${GREEN}🔐 Configurando Stunnel (TLS Wrapper)...${NC}"
mkdir -p/etc/stunnel
openssl req -novo -x509 -dias 3650 -nós -saída/etc/stunnel/stunnel.pem \
 -keyout/etc/stunnel/stunnel.pem -subj "/C=BR/ST=SP/L=SAO/O=FusionSSH" 2>/dev/null

gato > /etc/stunnel/stunnel.conf << EOF
cliente = não
certificado = /etc/stunnel/stunnel.pem
sslVersion = TLSv1.2
opções = NO_SSLv3

[ssh-tls]
aceitar = $STUNNEL_PORT
conectar = 127.0.0.1:$DROPBEAR_PORT
EOF
systemctl habilitar stunnel4 && systemctl reiniciar stunnel4

echo -e "${GREEN}🔄 Instalando V2Ray...${NC}"
bash <(curl -L https://raw.githubusercontent.com/v2fly/fhs-install-v2ray/master/install-release.sh)

cat > /usr/local/etc/v2ray/config.json << EOF
{
 "limites": [{
 "porta": $V2RAY_PORT,
 "protocolo": "sem v",
 "configurações": {
 "clientes": [{"id": "$(cat/proc/sys/kernel/random/uuid)", "nível": 0, "email": "fusion@vless"}],
 "descriptografia": "nenhum"
 }, "configurações de fluxo": {
 "rede": "ws",
 "wsSettings": {"caminho": "/fusion-ws"}
    }
 }],
 "outbounds": [{"protocolo": "liberdade"}]
}
EOF
systemctl habilitar v2ray && systemctl reiniciar v2ray

echo -e "${VERDE}⚡ Instalando XRay...${NC}"
bash <(curl -L https://github.com/XTLS/Xray-install/raw/main/install-release.sh)

cat > /usr/local/etc/xray/config.json << EOF
{
 "limites": [{
 "porta": $XRAY_PORT,
 "protocolo": "sem v",
 "configurações": {
 "clientes": [{"id": "$(cat/proc/sys/kernel/random/uuid)", "nível": 0, "email": "fusion@xray"}],
 "descriptografia": "nenhum"
 },
 "configurações de fluxo": {
 "rede": "tcp"
    }
 }],
 "outbounds": [{"protocolo": "liberdade"}]
}
EOF
systemctl habilitar raio-x && systemctl reiniciar raio-x

echo -e "${VERDE}🛡️ Configurando Fail2Ban e Firewall...${NC}"
gato > /etc/fail2ban/jail.local << EOF
[sshd]
habilitado = verdejeiro
porta = $SSH_PORT,$DROPBEAR_PORT
filtro = sshd
logpath = /var/log/auth.log
maxretry = 5
bantime = 3600
EOF
systemctl habilitar fail2ban && systemctl reiniciar fail2ban

ufw padre negra entrada
ufw permite $SSH_PORT/tcp
ufw permite $DROPBEAR_PORT/tcp
ufw permite $STUNNEL_PORT/tcp
ufw permite $V2RAY_PORT/tcp
ufw permite $XRAY_PORT/tcp
ufw --forçar habilidade
echo -e "${GREEN}👤 Criando usuário admin...${NC}"
useradd -m -s/bin/bash $ADMIN_USER 2>/dev/null || verdadeiro
echo "$ADMIN_USER:$ADMIN_PASS" | chpasswd
usermod -aG sudo $ADMIN_USER

echo -e "${VERDE}📊 Criando painel de controle...${NC}"
gato > /usr/local/bin/fusion-panel << 'PAINEL'
#!/lata/bash
claro
eco "╔══════════════════════════════════════════╗"
eco "║ ⚡ PAINEL SSH DE FUSÃO ⚡ ║"
eco "╚══════════════════════════════════════════╝"
eco ""
echo " [1] Status dos Serviços"
eco "[2] Reiniciar Todos"
echo " [3] Ver Logs"
echo " [4] Informações do Sistema"
eco "[0] Sair"
eco ""
leia -p " > " opte
caso $opt in
 1) systemctl status ssh dropbear stunnel4 v2ray xray --no-pager -l ;;
 2) systemctl reiniciar ssh dropbear stunnel4 v2ray xray ;;
 3) cauda -n 30/var/log/auth.log ;;
 4) neofetch || echo "Neofetch instalado: apt install neofetch" ;;
 0) saída 0 ;;
 *) eco "Inválido" ;;
esaci
PAINEL
chmod +x/usr/local/bin/fusion-panel

eco ""
echo -e "${VERDE}╔══════════════════════════════════════════╗${NC}"
echo -e "${VERDE}║ ✅ INSTALAÇÃO CONCLUÍDA! ║${NC}"
echo -e "${VERDE}╚══════════════════════════════════════════╝${NC}"
eco ""
echo -e "${CYAN}👤 Administrador:${NC} $ADMIN_USER"
echo -e "${CYAN}🔑 Senha:${NC} $ADMIN_PASS"
echo -e "${CYAN}📡 Portas:${NC} SSH:$SSH_PORT | Dropbear:$DROPBEAR_PORT | Stunnel:$STUNNEL_PORT"
echo -e "${CYAN}🚀 V2Ray:${NC} ws://IP:$V2RAY_PORT/fusion-ws"
echo -e "${CYAN}⚡ Raio X:${NC} IP:$XRAY_PORT"
eco ""
echo -e "${YELLOW}💡 Dica: Digite 'fusion-panel' para acessar o menu${NC}"
